      "UNION": ["UNION ALL", "UNION DISTINCT", "UN/*!*/ION", "UNIunionON", "UNION(SELECT)", "UN'ION'"],
      "SELECT": ["SELECT(", "SEL/*!*/ECT", "SeLeCt", "/*!50000SELECT*/", "select-1.0"],
      "AND": ["&&", "AND-", "AND+", "AND~", "AND!", "*"],
      "OR": ["||", "OR+", "|"],
      "NOT": ["!", "NOT!"],
