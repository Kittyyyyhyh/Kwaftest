[
  {"id": "P0-motd",     "path": "/etc/motd",                "tier": "P0", "severity": "L3",
   "verify": {"type": "honeytoken", "pattern": "hp-d0e1f2a3"}},
  {"id": "P0-hostname", "path": "/etc/hostname",            "tier": "P0", "severity": "L3",
   "verify": {"type": "honeytoken", "pattern": "hp-b4c5d6e7"}},
  {"id": "P1-settings", "path": "/srv/app/settings.json",   "tier": "P1", "severity": "L2",
   "verify": {"type": "honeytoken", "pattern": "hp-f8a9b0c1"}},
  {"id": "P1-data",     "path": "/srv/app/data.xml",        "tier": "P1", "severity": "L2",
   "verify": {"type": "honeytoken", "pattern": "hp-a1b2c3d4"}},
  {"id": "P2-db",       "path": "/srv/data/db.json",        "tier": "P2", "severity": "L1",
   "verify": {"type": "honeytoken", "pattern": "hp-f8a9b0c1"}},
  {"id": "whoami",      "cmd":  "whoami",                    "tier": "CMD","severity": "L1",
   "verify": {"type": "output", "pattern": "www-data"}},
  {"id": "id",          "cmd":  "id",                        "tier": "CMD","severity": "L1",
   "verify": {"type": "output", "pattern": "uid="}},
  {"id": "touch-php",   "cmd":  "touch", "path": "/srv/app/created.php",  "tier": "P1","severity": "L3",
   "verify": {"type": "side_effect", "action": "file_exists", "path": "/srv/app/created.php", "expected": true,
              "pre_setup": {"action": "file_delete", "path": "/srv/app/created.php"}}},
  {"id": "rm-db",       "cmd":  "rm",    "path": "/srv/data/db.json",    "tier": "P2","severity": "L3",
   "verify": {"type": "side_effect", "action": "file_exists", "path": "/srv/data/db.json", "expected": false,
              "pre_setup": {"action": "file_create", "path": "/srv/data/db.json", "content": "touch-me"}}}
