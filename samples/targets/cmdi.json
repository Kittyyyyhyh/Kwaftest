[
  {"id": "P0-motd",     "payload": "cat /etc/motd",                "tier": "P0", "severity": "L3",
   "success_on": {"check": "response_contains", "value": "hp-d0e1f2a3"}},
  {"id": "P0-hostname", "payload": "cat /etc/hostname",            "tier": "P0", "severity": "L3",
   "success_on": {"check": "response_contains", "value": "hp-b4c5d6e7"}},
  {"id": "P1-settings", "payload": "cat /srv/app/settings.json",   "tier": "P1", "severity": "L2",
   "success_on": {"check": "response_contains", "value": "hp-f8a9b0c1"}},
  {"id": "P1-data",     "payload": "cat /srv/app/data.xml",        "tier": "P1", "severity": "L2",
   "success_on": {"check": "response_contains", "value": "hp-a1b2c3d4"}},
  {"id": "P2-db",       "payload": "cat /srv/data/db.json",        "tier": "P2", "severity": "L1",
   "success_on": {"check": "response_contains", "value": "hp-f8a9b0c1"}},
  {"id": "whoami",      "payload": "whoami",                        "tier": "CMD","severity": "L1",
   "success_on": {"check": "response_contains", "value": "www-data"}},
  {"id": "id",          "payload": "id",                            "tier": "CMD","severity": "L1",
   "success_on": {"check": "response_contains", "value": "uid="}},
  {"id": "touch-php",   "payload": "touch /srv/app/created.php",   "tier": "P1", "severity": "L3",
   "success_on": {"check": "file_exists", "value": true, "path": "/srv/app/created.php"},
   "pre_setup": {"action": "file_delete", "path": "/srv/app/created.php"}},
  {"id": "rm-db",       "payload": "rm /srv/data/db.json",         "tier": "P2", "severity": "L3",
   "success_on": {"check": "file_missing", "value": true, "path": "/srv/data/db.json"},
   "pre_setup": {"action": "file_create", "path": "/srv/data/db.json", "content": "x"}}
]
