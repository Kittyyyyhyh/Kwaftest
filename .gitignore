# Docker
db_data/

# Logs & Reports (generated at runtime)
logs/*
!logs/.gitkeep
reports/*
!reports/.gitkeep

# Generated samples (runtime artifacts)
samples/batches/*
!samples/batches/.gitkeep
samples/results/*
!samples/results/.gitkeep

# Uploaded files (runtime)
app/uploads/*
!app/uploads/.gitkeep

# Old flag system (replaced by honeytokens)
flags/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
CLAUDE.md

# Decoy credential / honeytoken files (fake flags, look like real secrets — do not publish)
app/flag_*

# Internal archive (removed samples + historical test data, contains target IPs)
samples/_archive_*/

# Pre-sanitization skill backup archive (binary, un-scannable for secrets)
.claude/skills/*.rar

# Local Log4j verification harness build artifacts (jars/class)
.verify_log4j/

# Round input probes (transient Layer-1 seeds)
.claude/skills/semantic-mining/probes_*.jsonl

# Temp CSV exports
platform/tmp_export.csv

# Platform archive (removed samples + historical test data, contains target IPs)
.claude/samples/_archive_*/
